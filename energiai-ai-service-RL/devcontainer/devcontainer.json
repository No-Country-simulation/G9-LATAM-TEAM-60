{
  "name": "EnergIAi Python ML Container",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "littlefoxteam.vscode-python-test-adapter"
