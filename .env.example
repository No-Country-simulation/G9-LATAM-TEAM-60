# ==============================================
# EnergiAI Backend - Variables de entorno
# Copiar este archivo como ".env" y completar con
# los valores reales. NUNCA commitear el .env real.
# ==============================================

# --- Base de datos (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/energiai
DB_USERNAME=energiai_user
DB_PASSWORD=changeme

# --- Seguridad / JWT ---
# Usar una clave larga y aleatoria en producción (no dejar el default del código)
JWT_SECRET=replace_with_a_long_random_secret

# --- Servicio de IA (Python/FastAPI) ---
# URL interna donde el microservicio de Data Science expone /api/v1/predict
AI_SERVICE_URL=http://localhost:8000

# --- OCI Object Storage (modelo serializado) ---
OCI_NAMESPACE=your_namespace
OCI_BUCKET_NAME=energiai-models
OCI_REGION=sa-saopaulo-1
